{
  "name": "conventional-changelog-anansi",
  "type": "module",
  "version": "0.4.0",
  "description": "Conventionalcommits.org preset for anansi.",
  "author": "Nathaniel Tucker",
  "license": "ISC",
  "homepage": "https://github.com/ntucker/conventional-changelog/tree/anansi/packages/conventional-changelog-conventionalcommits#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ntucker/conventional-changelog.git",
    "directory": "packages/conventional-changelog-conventionalcommits"
  },
  "bugs": {
    "url": "https://github.com/ntucker/conventional-changelog/issues"
  },
  "keywords": [
    "conventional-changelog",
    "conventionalcommits.org",
    "preset"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "types": "./src/index.d.ts",
    "import": "./src/index.js"
  },
  "publishConfig": {
    "directory": "package",
    "linkDirectory": false
  },
  "files": [
    "src"
  ],
  "scripts": {
    "clear": "del ./package",
    "prepublishOnly": "run clear clean-publish",
    "postpublish": "pnpm clear"
  },
  "dependencies": {
    "@conventional-changelog/template": "workspace:^"
  },
  "devDependencies": {
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "conventional-changelog-writer": "workspace:^",
    "conventional-changelog-writer-8": "npm:conventional-changelog-writer@^8.4.0"
  }
}
