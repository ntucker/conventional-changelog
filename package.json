{
  "name": "conventional-changelog",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "description": "Generate a changelog from git metadata.",
  "author": {
    "name": "Steve Mao",
    "email": "maochenyan@gmail.com",
    "url": "https://github.com/stevemao"
  },
  "license": "ISC",
  "homepage": "https://github.com/conventional-changelog/conventional-changelog#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/conventional-changelog/conventional-changelog.git"
  },
  "bugs": "https://github.com/conventional-changelog/conventional-changelog/issues",
  "keywords": [
    "conventional-changelog",
    "readme",
    "generation"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clear": "pnpm -r --parallel --if-present clear && del ./coverage",
    "build": "pnpm -r --parallel --if-present build",
    "lint": "eslint '*.{js,cjs}' 'packages/**/*.{js,cjs,ts}'",
    "format": "pnpm lint --fix",
    "test:types": "pnpm -r --parallel --if-present test:types",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest watch",
    "test": "run -p lint test:types test:unit",
    "commit": "cz",
    "updateGitHooks": "simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.2",
    "@commitlint/config-conventional": "^19.2.2",
    "@commitlint/config-pnpm-scopes": "^19.1.0",
    "@commitlint/cz-commitlint": "^19.2.0",
    "@trigen/eslint-config": "8.0.0-alpha.33",
    "@trigen/scripts": "8.0.0-alpha.33",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "better-than-before": "^1.0.0",
    "clean-publish": "^5.0.0",
    "commitizen": "^4.3.2",
    "conventional-changelog": "workspace:^",
    "del-cli": "^6.0.0",
    "eslint": "^8.0.0",
    "inquirer": "^12.0.0",
    "nano-staged": "^0.8.0",
    "simple-git-hooks": "^2.11.1",
    "tsm": "^2.3.0",
    "typescript": "^5.2.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@babel/runtime@<7.26.10": "7.26.10",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "cross-spawn@>=7.0.0 <7.0.5": "7.0.5",
      "esbuild@<=0.24.2": "0.25.0",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "flatted@<=3.4.1": "3.4.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "minimatch@<3.1.4": "3.1.4",
      "nanoid@<3.3.18": "3.3.18",
      "picomatch@<2.3.2": "2.3.2",
      "postcss@<=8.5.22": "8.5.23",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "tmp@<0.2.7": "0.2.7"
    }
  }
}
